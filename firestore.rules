rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in AND has clicked the email verification link
    function isVerified() {
      return request.auth != null
             && request.auth.token.email_verified == true;
    }

    // USERS — each user can create/read/update only their own profile document.
    // create stays open to unverified users: signup writes it before verification.
    match /users/{userId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if isVerified() && request.auth.uid == userId;
      allow delete: if false;
    }

    // PROPERTIES — public read (browse listings); any verified user can create;
    // only the owner (matched via ownerId) can update or delete
    match /properties/{propertyId} {
      allow read:          if true;
      allow create:        if isVerified();
      allow update, delete: if isVerified()
                            && resource.data.ownerId == request.auth.uid;
    }

    // APPLICATIONS — a tenant creates their own application; the tenant and the
    // property owner can read it; only the owner can update its status
    match /applications/{applicationId} {
      allow read:   if request.auth != null
                    && (resource.data.tenantId == request.auth.uid
                        || resource.data.ownerId == request.auth.uid);
      allow create: if isVerified()
                    && request.resource.data.tenantId == request.auth.uid;
      allow update: if isVerified()
                    && resource.data.ownerId == request.auth.uid;
      allow delete: if false;
    }
  }
}
